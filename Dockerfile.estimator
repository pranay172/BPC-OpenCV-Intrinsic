FROM ros:jazzy-perception AS base

SHELL [ "/bin/bash" , "-c" ]

ARG DEBIAN_FRONTEND=noninteractive

# Add CUDA repository and install CUDA toolkit
RUN apt-get update && apt-get install -y --no-install-recommends \
    wget software-properties-common gnupg2 python3-venv \
    build-essential\
    && rm -rf /var/lib/apt/lists/*

RUN wget -q https://developer.download.nvidia.com/compute/cuda/repos/ubuntu2404/x86_64/cuda-keyring_1.1-1_all.deb && \
    dpkg -i cuda-keyring_1.1-1_all.deb && \
    rm cuda-keyring_1.1-1_all.deb && \
    apt-get update && \
    apt-get -y install cuda-toolkit && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /opt/ros/underlay

# Environment variables for ROS
ENV ROS_HOME=/tmp
ENV RMW_IMPLEMENTATION=rmw_zenoh_cpp

# underlay stage: base + dependencies built
FROM base AS underlay

ADD ibpc_interfaces /opt/ros/underlay/src/ibpc_interfaces

RUN . /opt/ros/jazzy/setup.sh \
    && apt-get update \
    && rosdep update \
    && rosdep install --from-paths src --ignore-src --rosdistro jazzy -yr \
    && colcon build --cmake-args -DCMAKE_BUILD_TYPE=Release \
    --event-handlers=console_direct+ \
    --merge-install

# Copy the models directory (including pre-downloaded checkpoints)
ADD models /opt/ros/underlay/install/models

FROM underlay AS overlay

ARG SERVICE_PACKAGE=ibpc_pose_estimator_py
ARG SERVICE_EXECUTABLE_NAME=ibpc_pose_estimator

# Install system dependencies for both ROS and vision processing
RUN apt-get update \
    && apt install -y ros-jazzy-rmw-zenoh-cpp python3-opencv python3-pip \
       python3-scipy python3-yaml python3-imageio python3-pandas python3-tk \
       python3-venv python3-full libgl1 libglvnd0 libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

# Create and activate a virtual environment for Python packages
RUN python3 -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# Install Python dependencies in the virtual environment
RUN pip3 install --upgrade pip==25.0.1 && pip3 install --no-cache-dir \
    torch==2.6.0 torchvision==0.21.0 \
    numpy==1.26.4 scipy==1.15.2 blenderproc==2.8.0 \
    trimesh==4.6.8 pyrender==0.1.45 distinctipy==1.3.4 \
    pycocotools==2.0.8 gorilla-core==0.2.7.8 \
    timm==1.0.15 einops==0.8.1 shapely==2.1.0 opencv-python==4.11.0.86 \
    xformers==0.0.29.post3 fvcore==0.1.5.post20221221 iopath==0.1.10 \
    pytorch-lightning==2.5.1 ultralytics==8.3.131

ADD ${SERVICE_PACKAGE} /opt/ros/overlay/src/${SERVICE_PACKAGE}

# Install pointnet2 module
RUN cd /opt/ros/overlay/src/${SERVICE_PACKAGE}/${SERVICE_PACKAGE}/Pose_Estimation_Model/model/pointnet2 \
    && TORCH_CUDA_ARCH_LIST="6.0;6.1;7.0;7.5;8.0;8.6+PTX" python setup.py install

RUN . /opt/ros/jazzy/setup.sh \
    && . /opt/ros/underlay/install/setup.sh \
    && cd /opt/ros/overlay \
    && colcon build --cmake-args -DCMAKE_BUILD_TYPE=Release \
    --event-handlers=console_direct+ \
    --merge-install

# result stage: base + copied install folders from the overlay + service setup.
FROM base

ARG SERVICE_PACKAGE=ibpc_pose_estimator_py
ARG SERVICE_EXECUTABLE_NAME=ibpc_pose_estimator

# Install system dependencies
RUN apt-get update \
    && apt upgrade -y \
    && apt install -y ros-jazzy-rmw-zenoh-cpp python3-opencv python3-pip \
       python3-scipy python3-yaml python3-imageio python3-pandas python3-tk \
       python3-venv python3-full libgl1 libglvnd0 libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

# Create and activate a virtual environment for Python packages
RUN python3 -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# Install Python dependencies in the virtual environment
RUN pip3 install --upgrade pip==25.0.1 && pip3 install --no-cache-dir \
    torch==2.6.0 torchvision==0.21.0 \
    numpy==1.26.4 scipy==1.15.2 blenderproc==2.8.0 \
    trimesh==4.6.8 pyrender==0.1.45 distinctipy==1.3.4 \
    pycocotools==2.0.8 gorilla-core==0.2.7.8 \
    timm==1.0.15 einops==0.8.1 shapely==2.1.0 opencv-python==4.11.0.86 \
    xformers==0.0.29.post3 fvcore==0.1.5.post20221221 iopath==0.1.10 \
    pytorch-lightning==2.5.1 ultralytics==8.3.131

COPY --from=overlay /opt/ros/underlay/install /opt/ros/underlay/install
COPY --from=overlay /opt/ros/overlay/install /opt/ros/overlay/install
COPY --from=overlay /opt/ros/overlay/src/${SERVICE_PACKAGE} /opt/ros/overlay/src/${SERVICE_PACKAGE}
COPY --from=overlay /opt/venv /opt/venv

# Install pointnet2 module in the final stage as well
RUN . /opt/venv/bin/activate \
    && cd /opt/ros/overlay/src/${SERVICE_PACKAGE}/${SERVICE_PACKAGE}/Pose_Estimation_Model/model/pointnet2 \
    && TORCH_CUDA_ARCH_LIST="6.0;6.1;7.0;7.5;8.0;8.6+PTX" python setup.py install

RUN sed --in-place \
    --expression '$isource "/opt/ros/overlay/install/setup.bash"' \
    /ros_entrypoint.sh

ENV SERVICE_PACKAGE=${SERVICE_PACKAGE}
ENV SERVICE_EXECUTABLE_NAME=${SERVICE_EXECUTABLE_NAME}
ENV MODEL_DIR=/opt/ros/underlay/install/models

# Create directory for temporary output files
RUN mkdir -p ${MODEL_DIR}/output

# Set PYTHONPATH to include all necessary directories
ENV PYTHONPATH="/opt/venv/lib/python3.12/site-packages:/opt/ros/overlay/install/lib/${SERVICE_PACKAGE}:/opt/ros/overlay/src/${SERVICE_PACKAGE}:/opt/ros/overlay/src/${SERVICE_PACKAGE}/${SERVICE_PACKAGE}:/opt/ros/overlay/src/${SERVICE_PACKAGE}/${SERVICE_PACKAGE}/Instance_Segmentation_Model:/opt/ros/overlay/src/${SERVICE_PACKAGE}/${SERVICE_PACKAGE}/Pose_Estimation_Model"

# Include the virtual environment activation in the entrypoint
RUN echo '. /opt/venv/bin/activate' >> /ros_entrypoint.sh

CMD exec /opt/ros/overlay/install/lib/${SERVICE_PACKAGE}/${SERVICE_EXECUTABLE_NAME} \
    --ros-args -p model_dir:=${MODEL_DIR}